"doi": "10.1038/s41698-026-01451-9",
"title": "Predicting immunotherapy benefit in leiomyosarcoma through active chromatin cfDNA profiling",
"authors": [
"Lopes CDH",
"Wu HT",
"Dilger K",
"Zhang YW",
"Salawu A",
"Stayner LA",
"Gupta AA",
"Hansen AR",
"Spreafico A",
"Bedard PL",
"Louie MC",
