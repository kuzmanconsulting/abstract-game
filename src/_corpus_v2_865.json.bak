{
"id": "doi:10.64898/2026.02.23.26346900",
"epmc_id": "PPR1268359",
"source": "preprint",
"server": "medRxiv",
"pmid": null,
"doi": "10.64898/2026.02.23.26346900",
"title": "Tumor-Specific Divergence of Tumor-Associated Macrophage Prognostic Effects Across TCGA Lung and Melanoma Cohorts",
"authors": [
"Lehrer S",
"Rheinstein PH"
],
"author_string": "Lehrer S, Rheinstein PH.",
"journal": "medRxiv",
"year": 2026,
"date": "2026-02-24",
"field": "cancergen",
"sections": [
{
"label": "Background",
"text": "Tumor-associated macrophages (TAMs) display context-dependent functional polarization, but whether their prognostic impact is consistent across tumor types remains unclear."
},
{
"label": "Methods",
"text": "We analyzed RNA-sequencing and clinical data from The Cancer Genome Atlas (TCGA) lung adenocarcinoma (LUAD; n=648), lung squamous carcinoma (LUSC; n=623), and melanoma (SKCM; n=466). Cox proportional hazards models adjusted for age and AJCC stage evaluated per–standard deviation (SD) expression of TAM markers (FOLR2, TREM2) and T-cell markers (CD8A, CXCL9). Cross-histology interaction terms tested divergence between LUAD and LUSC."
},
{
"label": "Results",
"text": "In melanoma, higher FOLR2 (HR 0.87), TREM2 (HR 0.83), CD8A (HR 0.69), and CXCL9 (HR 0.67) independently predicted improved survival. LUAD showed largely neutral macrophage effects. In contrast, LUSC demonstrated an adverse association for FOLR2 (HR 1.28). Interaction analysis confirmed significant divergence for FOLR2 and TREM2 between LUAD and LUSC."
},
{
"label": "Conclusions",
"text": "TAM-associated prognostic effects reverse by tumor histology, supporting tumor-context–dependent macrophage polarization and informing macrophage-targeted therapeutic strategies."
}
],
"n_chars": 1139,
"structured": true,
