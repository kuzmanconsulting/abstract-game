"doi": "10.1038/s41591-026-04291-z",
"title": "Liquid biopsy for the diagnosis of EBV-positive Burkitt's lymphoma in endemic areas",
"authors": [
"Chamba C",
"Christopher H",
"Josephat E",
"Sseruyange J",
"Ayitewala A",
"Howard K",
"Dreau H",
"Burns A",
"Legason I",
"Otim I",
"Mapendo P",
"Mnango L",
"Ngaiza A",
"Mremi A",
"Elias E",
"Achola C",
"Mawalla W",
"Shungu R",
"Mkwizu E",
"Chirande L",
"Mwamtemi H",
"Mahawi S",
"Sandi G",
"Kashaigili HJ",
"Gerlevik S",
"Ntemi PS",
"Magorosa E",
"Mbwambo D",
"Tungu M",
"Ogwang M",
"Chiwanga F",
"Mbulaiteye SM",
