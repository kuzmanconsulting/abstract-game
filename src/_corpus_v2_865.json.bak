"pmid": null,
"doi": "10.1101/2025.09.03.25334985",
"title": "Early Prediction of Gestational Diabetes Using Integrated Cell-free DNA Features and Omics-derived Genetic Scores",
"authors": [
"Dao VN",
"Tran N",
"Vo T",
"Le H",
"Nguyen TT",
"Nguyen QV",
"Ha MT",
"Le TM",
"Hoang DT",
"Huynh KN",
