"n": 296
},
{
"id": "pmid:42851095",
"epmc_id": "42851095",
"source": "journal",
"server": null,
"pmid": "42851095",
"doi": "10.29271/jcpsp.2026.10.1287",
"title": "Identification and Clinical Significance of Differentially Expressed Genes in the Tumour Microenvironment of Clear Cell Renal Cell Carcinoma",
"authors": [
"Yang R",
"Guo Y"
],
"author_string": "Yang R, Guo Y.",
"journal": "Journal of the College of Physicians and Surgeons--Pakistan : JCPSP",
"year": 2026,
"date": "2026-10-01",
"field": "cancergen",
"sections": [
{
"label": "Objective",
"text": "To perform a bioinformatics analysis of differentially expressed genes (DEGs) in clear cell renal cell carcinoma (ccRCC), evaluate their clinical significance, and identify potential therapeutic targets for ccRCC."
},
{
"label": "Study design",
"text": "An analytical study. Place and Duration of the Study: Department of Clinical Medicine, Inner Mongolia Medical University, Hohhot, China, from February 2024 to March 2026."
},
{
"label": "Methodology",
"text": "RNA-sequencing data from 601 patients with ccRCC in the Cancer Genome Atlas (TCGA) were analysed using R. Immune and stromal scores were estimated using ESTIMATE, and immune-cell fractions were calculated using CIBERSORT. Associations with survival and clinicopathological features were assessed. Overlapping DEGs from ImmuneScore and StromalScore groups underwent Gene Ontology (GO) and Kyoto Encyclopaedia of Genes and Genomes (KEGG) enrichment analyses. A protein-protein interaction (PPI) network and univariate Cox regression were used to identify prognostic genes. Core genes were identified by intersecting PPI hub nodes with significant Cox predictors, followed by immune-infiltration analysis."
},
{
"label": "Results",
"text": "The immune score showed significant relationships with both overall survival and clinicopathological characteristics in ccRCC (p <0.05). Differential expression screening retained 375 shared DEGs. Functional enrichment identified 114 significant GO terms and 28 significant KEGG pathways (p <0.05). Plasminogen (PLG) emerged as the core candidate associated with survival and clinicopathological stage (p <0.05). CIBERSORT analysis further demonstrated significant differences in resting dendritic cells, resting mast cells, plasma cells, M0 macrophages, and activated memory CD4⁺ T cells between the high- and low-PLG-expression groups (p <0.05)."
},
{
"label": "Conclusion",
"text": "Bioinformatics analysis identified PLG as a core gene associated with ccRCC prognosis and immune-cell infiltration, thereby providing a basis for subsequent mechanistic investigation and external validation."
},
{
"label": "Key words",
"text": "Clear cell renal cell carcinoma, Tumour microenvironment, Plasminogen, The Cancer Genome Atlas, ESTIMATE, CIBERSORT."
}
],
"n_chars": 2060,
"structured": true,
"has_results": true,
