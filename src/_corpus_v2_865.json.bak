"doi": "10.12788/fp.0607",
"title": "Comprehensive Genomic Profiles of Melanoma in Veterans Compared to Reference Databases",
"authors": [
"Mettman D",
"Stoieva M",
"Abdo M"
],
"author_string": "Mettman D, Stoieva M, Abdo M.",
"journal": "Federal practitioner : for the health care professionals of the VA, DoD, and PHS",
"year": 2025,
"date": "2025-08-15",
"field": "cancergen",
"sections": [
{
"label": "Background",
"text": "Veterans represent a unique patient population with various exposures that may predispose them to cancer. Mutational signatures associated with these exposures are described in other tumor types."
},
{
"label": "Methods",
"text": "This retrospective review analyzes the comprehensive genomic profiling reports of 35 veterans with metastatic melanoma at a large US Department of Veterans Affairs medical center. The genomic findings were compared with those from the Catalogue of Somatic Mutations in Cancer and The Cancer Genome Atlas."
},
{
"label": "Results",
"text": "The melanomas found in these veterans showed a significantly higher frequency of variants in CDKN2A/B ; a significantly lower frequency of variants in ROS1 , GRIN2A , KDR , KMT2C ( MLL3 ), KMT2D ( MLL2 ), LRP1B , PTPRT , PTCH1 , FAT4 , and PREX2 ; and a significantly higher frequency of tumor mutational burdens exceeding 10 mutations/megabase."
},
{
"label": "Conclusions",
"text": "The presence of statistically significant differences between the genomic findings from the veterans' melanomas and those of general population melanomas from reference databases suggests that additional research is warranted to corroborate these differences and clarify their etiologic, prognostic, and therapeutic relevance."
}
],
"n_chars": 1173,
"structured": true,
"has_results": true,
"pub_types": [
"research-article",
