"pmid": "42686803",
"doi": "10.1038/s41698-026-01657-x",
"title": "High-grade serous ovarian cancer is associated with increased TP53 mutation burden in uterine lavage",
"authors": [
"Heinzl N",
"Ghezelayagh TS",
"Wang G",
"Kohrn BF",
"Katz R",
"Coombes C",
"Smith TH",
"Norgaard ZK",
"Lo FY",
"Schmidt EK",
"Higgins JE",
"Valentine CC 3rd",
"Filipits M",
"Romanens L",
"Labidi-Galy I",
"Postl M",
"Grimm C",
"Cibula D",
"Dostálek L",
"Frühauf F",
"Jelenek G",
"Plch M",
"Fabian P",
"Mustea A",
"Condic M",
"Pristauz-Telsnigg G",
"Tamussino K",
"Bouda J",
"Brambs CE",
"O'Toole S",
"Bischof K",
"Grill S",
"Rosenthal AN",
"Vanderstichele A",
"Oppelt P",
"Rinda Soong T",
"Norquist BM",
"Salk JJ",
"Zeillinger R",
"Speiser P",
"Risques RA"
],
"author_string": "Heinzl N, Ghezelayagh TS, Wang G, Kohrn BF, Katz R, Coombes C, Smith TH, Norgaard ZK, Lo FY, Schmidt EK, Higgins JE, Valentine CC, Filipits M, Romanens L, Labidi-Galy I, Postl M, Grimm C, Cibula D, Dostálek L, Frühauf F, Jelenek G, Plch M, Fabian P, Mustea A, Condic M, Pristauz-Telsnigg G, Tamussino K, Bouda J, Brambs CE, O'Toole S, Bischof K, Grill S, Rosenthal AN, Vanderstichele A, Oppelt P, Rinda Soong T, Norquist BM, Salk JJ, Zeillinger R, Speiser P, Risques RA.",
"journal": "NPJ precision oncology",
"year": 2026,
"date": "2026-08-29",
"field": "cancergen",
"sections": [
{
"label": null,
"text": "High grade serous ovarian cancer (HGSC) has low survival partly due to the lack of methods for detection, diagnosis, and risk prediction. TP53 mutations, which drive HGSC, are found in gynecological tissues as the result of somatic evolution, but it is unknown whether an excess of mutations is linked to ovarian cancer. Here we investigate if TP53 mutation burden measured in uterine lavage, a minimally invasive gynecological liquid biopsy, can discriminate between patients with and without HGSC. We used ultradeep TP53 duplex sequencing (>15,000x duplex depth) to detect TP53 mutations in uterine lavage collected pre-operatively in 278 patients undergoing gynecological surgery for pelvic masses (average risk) or cancer risk-reduction (high risk). All lavages contained multiple TP53 mutant clones, which were used to quantify TP53 mutation burden frequency (MBF). Average risk patients with HGSC had significantly higher TP53 MBF independently of age and other risk factors (77% sensitivity, 89% specificity, AUC = 0.88). Excluding tumor TP53 clonal mutations from the lavage MBF calculation maintains this association, suggesting that it is the overall TP53 somatic mutation burden (rather than the discovery of the specific tumor driver mutation) that identifies HGSC. These results demonstrate that TP53 somatic mutations are common in uterine lavage but more abundant in patients with HGSC, highlighting a connection between TP53 somatic evolution and ovarian cancer. Uterine lavage offers a minimally invasive approach that could be valuable to identify patients with HGSC."
}
],
"n_chars": 1585,
"structured": false,
