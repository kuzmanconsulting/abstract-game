"n": 552
},
{
"id": "doi:10.1101/2024.07.11.24310105",
"epmc_id": "PPR880145",
"source": "preprint",
"server": "medRxiv",
"pmid": null,
"doi": "10.1101/2024.07.11.24310105",
"title": "Low-dose chemotherapy combined with delayed immunotherapy in the neoadjuvant treatment of non-small cell lung cancer and dynamic monitoring of the drug response in peripheral blood",
"authors": [
"Liang C",
"Song Q",
"Zhou W",
"Li N",
"Xiong Q",
"Pan C",
"Zhao S",
"Yan X",
"Zhang X",
"Long Y",
"Guo J",
"Wang T",
"Shi W",
"Sun S",
"Yang B",
"Dong Z",
"Luo H",
"Li J",
"Hu Y",
"Yang B"
],
"author_string": "Liang C, Song Q, Zhou W, Li N, Xiong Q, Pan C, Zhao S, Yan X, Zhang X, Long Y, Guo J, Wang T, Shi W, Sun S, Yang B, Dong Z, Luo H, Li J, Hu Y, Yang B.",
"journal": "medRxiv",
"year": 2024,
"date": "2024-07-12",
"field": "cfdna",
"sections": [
{
"label": "Background",
"text": "Despite chemo-immunotherapy has been applied to the neoadjuvant treatment of non-small cell lung cancer (NSCLC), the impacts of dosage and the order of medication on treatment efficacy and safety remain largely unexplored. We originally designed an exploratory study to investigate the efficacy and safety of reduced-dose chemotherapy combined with delayed immunotherapy as well as the dynamic changes of circulating tumor DNA (ctDNA) and T cell receptor (TCR) during the therapy."
},
{
"label": "Methods",
"text": "Patients with clinical stage IIA to IIIA resectable NSCLC were treated with 2 cycles of reduced-dose platinum-based chemotherapy on day 1 combined with immunotherapy on day 5. The same postoperative modified adjuvant therapy regimen was administered for 2 cycles. Plasma samples at different time-points were collected and performed with T cell receptor (TCR) and circulating tumor DNA (ctDNA) sequencing."
},
{
"label": "Results",
"text": "38 patients received modified chemo-immunotherapy. The proportion of patients exhibiting complete response and partial response was 5.3% and 68.4%, respectively. The confirmed objective response rate was 73.7%. Radiological downstaging was achieved in 39.5%. Major pathologic response and complete pathologic response were observed in 47.4% and 31.6% of patients, respectively. Only one patient experienced grade 3 adverse event. Further analyses revealed that this modified chemo-immunotherapy led to the expansion of predominant TCR clones and reduction of tumor burden after the first cycle of chemotherapy."
},
{
"label": "Conclusion",
"text": "The promising clinical efficacy and low side effects of modified neoadjuvant chemo-immunotherapy position it as a prospective and innovative strategy for NSCLC."
}
],
"n_chars": 1658,
"structured": true,
