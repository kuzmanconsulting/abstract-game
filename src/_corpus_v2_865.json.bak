{
"id": "pmid:39020404",
"epmc_id": "39020404",
"source": "journal",
"server": null,
"pmid": "39020404",
"doi": "10.1186/s13073-024-01362-z",
"title": "Spatial intra-tumour heterogeneity and treatment-induced genomic evolution in oesophageal adenocarcinoma: implications for prognosis and therapy",
"authors": [
"Brosda S",
"Aoude LG",
"Bonazzi VF",
"Patel K",
"Lonie JM",
"Belle CJ",
"Newell F",
"Koufariotis LT",
"Addala V",
"Naeini MM",
"Pearson JV",
"Krause L",
"Waddell N",
"Barbour AP"
],
"author_string": "Brosda S, Aoude LG, Bonazzi VF, Patel K, Lonie JM, Belle CJ, Newell F, Koufariotis LT, Addala V, Naeini MM, AGITG DOCTOR Investigators, Pearson JV, Krause L, Waddell N, Barbour AP.",
"journal": "Genome medicine",
"year": 2024,
"date": "2024-07-17",
"field": "cancergen",
"sections": [
{
"label": "Background",
"text": "Oesophageal adenocarcinoma (OAC) is a highly heterogeneous cancer with poor survival. Standard curative treatment is chemotherapy with or without radiotherapy followed by oesophagectomy. Genomic heterogeneity is a feature of OAC and has been linked to treatment resistance."
},
{
"label": "Methods",
"text": "Whole-genome sequencing data from 59 treatment-naïve and 18 post-treatment samples from 29 OAC patients was analysed. Twenty-seven of these were enrolled in the DOCTOR trial, sponsored by the Australasian Gastro-Intestinal Trials Group. Two biopsies from each treatment-naïve tumour were assessed to define 'shared' (between both samples) and 'private' (present in one sample) mutations."
},
{
"label": "Results",
"text": "Mutational signatures SBS2/13 (APOBEC) and SBS3 (BRCA) were almost exclusively detected in private mutation populations of treatment-naïve tumours. Patients presenting these signatures had significantly worse disease specific survival. Furthermore, mutational signatures associated with platinum-based chemotherapy treatment as well as high platinum enrichment scores were only detected in post-treatment samples. Additionally, clones with high putative neoantigen binding scores were detected in some treatment-naïve samples suggesting immunoediting of clones."
},
{
"label": "Conclusions",
"text": "This study demonstrates the high intra-tumour heterogeneity in OAC, as well as indicators for treatment-induced changes during tumour evolution. Intra-tumour heterogeneity remains a problem for successful treatment strategies in OAC."
}
],
